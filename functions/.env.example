GEMINI_MODEL=gemini-3.8-flash
# Daily quotas: 0 pauses, positive integers cap usage, -1 removes the daily cap.
# Unlimited daily usage does not remove provider billing caps or group permissions.
AI_DAILY_LIMIT=0
OCR_DAILY_PAGE_LIMIT=0
# Optional pilot allowlist; unset allows all authorized groups, empty blocks all.
# AI_ALLOWED_GROUP_IDS=GROUP_ID
MAX_PDF_PAGES=100
MAX_PDF_MB=15
# Set GEMINI_API_KEY with firebase functions:secrets:set GEMINI_API_KEY
